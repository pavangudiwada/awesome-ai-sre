# Server-only PostgreSQL connection.
DATABASE_URL=

# Set to exe only behind the exe reverse proxy. Otherwise leave blank and
# analytics/editorial throttles use a shared fail-closed network bucket.
TRUST_PROXY=

# Better Auth session configuration. Keep the two URLs identical in production
# (`https://aisrewatchlist.com` on the exe VM).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only signing secret for 10-minute pending Save/Follow intents.
AUTH_INTENT_SECRET=

# Optional identity providers. Leave both values blank to hide each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Resend magic-link delivery. Both are required to enable email sign-in.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# Test-only local magic-link capture. It is accepted only for loopback URLs outside production.
AUTH_E2E_CAPTURE_PATH=

# Server-only HMAC key for anonymous, daily-rotating analytics identifiers.
# Generate at least 32 random characters. Never expose this with NEXT_PUBLIC_.
ANALYTICS_HASH_SECRET=

# Cloudflare Turnstile anti-bot protection for public editorial submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only HMAC key for durable submission throttling identifiers.
# Generate at least 32 random characters. Never expose this with NEXT_PUBLIC_.
SUBMISSION_HASH_SECRET=

# Server-only HMAC key for privacy-preserving newsletter signup throttling.
# Required because public newsletter signup is enabled even when email delivery is not.
NEWSLETTER_RATE_LIMIT_SECRET=

# Required only when Resend newsletter delivery is enabled.
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Optional privacy-safe product analytics. Autocapture and session replay stay disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
