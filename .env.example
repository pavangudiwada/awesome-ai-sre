# Public Supabase browser configuration.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only connection through the Supabase transaction pooler.
DATABASE_URL=

# Server-only signing secret for 10-minute auth action intents.
AUTH_INTENT_SECRET=

# Server-only HMAC key for anonymous, daily-rotating analytics identifiers.
# Generate at least 32 random characters. Never expose this with NEXT_PUBLIC_.
ANALYTICS_HASH_SECRET=

# Optional privacy-safe product analytics. Autocapture and session replay stay disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Canonical production origin.
NEXT_PUBLIC_SITE_URL=https://aisre.pavangudiwada.dev
