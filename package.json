{
  "name": "ai-sre-watchlist",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run verify:production-traces",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "analytics:company-report": "tsx --env-file-if-exists=.env.local scripts/company-analytics-report.ts",
    "check:ui": "tsx scripts/check-ui-consistency.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "RUN_AUTHENTICATED_E2E=1 playwright test tests/e2e/authenticated-workflows.spec.ts --project=chromium",
    "test:db": "tsx --conditions=react-server scripts/test-direct-postgres.ts",
    "check": "npm run validate:catalog && npm run validate:tools && npm run check:ui && npm run audit:assets -- --max-warnings=4 && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:release": "npm run check && npm run test:e2e",
    "fetch:logos": "node scripts/fetch-project-logos.js",
    "fetch:logos:force": "node scripts/fetch-project-logos.js --force",
    "fetch:obs-screenshots": "node scripts/fetch-obs-screenshots.mjs",
    "fetch:favicons": "node scripts/fetch-favicons.js",
    "fetch:images": "node scripts/fetch-images.js",
    "generate:readme": "node generate-readme.js",
    "sync:catalog-refs": "tsx --env-file-if-exists=.env.local scripts/sync-catalog-refs.ts",
    "verify:catalog-refs": "tsx --env-file-if-exists=.env.local scripts/sync-catalog-refs.ts --verify",
    "sync:published-updates": "tsx --env-file-if-exists=.env.local scripts/sync-published-updates.ts",
    "operator:submissions": "tsx --env-file-if-exists=.env.local scripts/review-submissions.ts",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "validate:tools": "node scripts/validate-tools.js",
    "verify:production-traces": "tsx scripts/verify-production-traces.ts",
    "db:health": "tsx scripts/verify-production-database.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "gray-matter": "4.0.3",
    "better-auth": "1.7.5",
    "js-yaml": "4.3.2",
    "lucide-react": "1.24.0",
    "next": "16.3.5",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "posthog-js": "1.399.1",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.28.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "image-size": "2.0.4",
    "jsdom": "29.1.1",
    "shadcn": "4.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": "3.15.2"
    },
    "hono": "4.13.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "packageManager": "bun@1.3.14"
}
