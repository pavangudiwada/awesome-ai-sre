# Install as /srv/awesome-ai-sre/shared/env/backup.env with mode 0600, owned by root.
# Never commit the values below or copy this file into a release directory.
#
# Cloudflare R2 S3 endpoint and dedicated bucket. The repository is encrypted
# client-side by restic; R2 only receives ciphertext.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/ai-sre-watchlist-backups
RESTIC_PASSWORD=

# A Cloudflare R2 S3 API token scoped to this bucket only, with Object Read & Write.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
