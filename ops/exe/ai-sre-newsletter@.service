[Unit]
Description=Send AI SRE Watchlist %i newsletter digest
After=network-online.target ai-sre.service
Wants=network-online.target

[Service]
Type=oneshot
User=exedev
Group=exedev
WorkingDirectory=/srv/awesome-ai-sre/current
Environment=NODE_ENV=production
EnvironmentFile=/srv/awesome-ai-sre/shared/env/app.env
ExecStart=/usr/local/bin/bun scripts/send-newsletter-digest.ts --frequency %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
